# Regenerados por Laravel Boost (`make boost`) desde .ai/ y boost.json.
# boost.json y las tres configuraciones MCP (.mcp.json, .codex/config.toml,
# .agents/mcp_config.json) sí se versionan: Boost no sabe generar el MCP
# dentro de Docker, y sin boost.json no hay regeneración no interactiva.
/CLAUDE.md
/AGENTS.md
/.agents/skills

# Traducciones compiladas por laravel-vue-i18n
/lang/php_*.json

# Configuracion local de Claude Code y skills instaladas por Boost.
# La fuente de verdad de las skills de dominio es .ai/skills/, que si se versiona;
# .claude/skills/ solo contiene enlaces simbolicos a ella mas las skills de
# framework que Boost reinstala con `make boost`.
/.claude/settings.local.json
/.claude/skills
